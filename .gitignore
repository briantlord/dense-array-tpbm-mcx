.DS_Store
.venv/
.local/
.pytest_cache/
.ruff_cache/
tmp/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Reproducibly acquired anatomy binaries; retain manifests, checksums, and licenses.
inputs/anatomy/**/*.zip
inputs/anatomy/**/*.nii
inputs/anatomy/**/*.nii.gz
inputs/anatomy/**/*.mnc
inputs/anatomy/colin27_2008/derived/native12_1mm_v1/
inputs/anatomy/colin27_2008/derived/native12_1mm_v2/

# Large simulation and analysis arrays; retain JSON manifests and summaries.
runs/**/*.jnii
runs/**/*.bnii
runs/**/*.nii
runs/**/*.nii.gz
runs/**/*.mc2
runs/**/*.mch
runs/**/*.npy
runs/**/*.npz
results/**/*.jnii
results/**/*.bnii
results/**/*.nii
results/**/*.nii.gz
results/**/*.npy
results/**/*.npz

# Local logs and machine-specific files.
*.log
.env
