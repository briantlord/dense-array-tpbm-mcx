{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["configuration_id", "synthetic_test_only", "nphoton", "volume", "time_gates_s", "source", "properties_mm", "seed", "outputtype", "isnormalize"],
  "properties": {
    "configuration_id": {"type": "string", "minLength": 1},
    "synthetic_test_only": {"type": "boolean"},
    "nphoton": {"type": "integer", "minimum": 1},
    "volume": {"type": "object", "additionalProperties": false, "required": ["generator", "shape_voxels", "label"], "properties": {"generator": {"const": "homogeneous_cube"}, "shape_voxels": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "items": false}, "label": {"type": "integer", "minimum": 0}}},
    "time_gates_s": {"type": "object", "additionalProperties": false, "required": ["start", "end", "step"], "properties": {"start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0}, "step": {"type": "number", "exclusiveMinimum": 0}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["emitter_id", "position_voxels", "direction", "type"], "properties": {"emitter_id": {"type": "string", "minLength": 1}, "position_voxels": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false}, "direction": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false}, "type": {"enum": ["pencil", "disk", "gaussian", "pattern"]}}},
    "properties_mm": {"type": "array", "minItems": 1, "items": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "minimum": 0}, {"type": "number", "minimum": 0, "exclusiveMaximum": 1}, {"type": "number", "minimum": 1}], "items": false}},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "outputtype": {"enum": ["flux", "fluence", "energy"]},
    "isnormalize": {"const": 1}
  }
}
