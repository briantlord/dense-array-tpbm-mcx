{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["anatomy_id", "synthetic_test_only", "source_dataset", "version", "source_url_or_doi", "access_date", "license", "subject_identity", "age_category", "native_voxel_size_mm", "final_voxel_size_mm", "resampling_method", "shape_voxels", "affine", "orientation", "coordinate_frame", "labels", "preprocessing", "volume_representation", "qc_status"],
  "properties": {
    "anatomy_id": {"type": "string", "minLength": 1},
    "synthetic_test_only": {"type": "boolean"},
    "source_dataset": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source_url_or_doi": {"type": "string", "minLength": 1},
    "access_date": {"type": "string", "format": "date"},
    "license": {"type": "string", "minLength": 1},
    "subject_identity": {"type": "string", "minLength": 1},
    "age_category": {"type": "string", "minLength": 1},
    "native_voxel_size_mm": {"$ref": "#/$defs/triplet"},
    "final_voxel_size_mm": {"$ref": "#/$defs/triplet"},
    "resampling_method": {"type": "string", "minLength": 1},
    "shape_voxels": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "items": false},
    "affine": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}},
    "orientation": {"type": "string", "minLength": 1},
    "coordinate_frame": {"type": "string", "minLength": 1},
    "labels": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "integer", "minimum": 0}, "name": {"type": "string", "minLength": 1}}}},
    "preprocessing": {"type": "string", "minLength": 1},
    "volume_representation": {"type": "string", "minLength": 1},
    "qc_status": {"enum": ["synthetic_test", "pending", "accepted", "rejected"]}
  },
  "$defs": {"triplet": {"type": "array", "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}], "items": false}}
}
