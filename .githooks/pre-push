#!/bin/sh
if [ "$(git config --bool privacy.privateWorkspace)" = "true" ]; then
    echo "Push blocked: private research checkout. Use the reviewed publication checkout." >&2
    exit 1
fi
if command -v python >/dev/null 2>&1; then
    exec python scripts/check_publication.py --pre-push
fi
exec uv run --frozen python scripts/check_publication.py --pre-push
